	partition dim_vivienda = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaSalida & "dim_vivienda.csv"),[Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Usar la primera fila como encabezado" = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    #"Cambiar tipo" = Table.TransformColumnTypes(#"Usar la primera fila como encabezado",{{"id_vivienda", Int64.Type}, {"floors", type number}, {"tiene_sotano", Int64.Type}, {"grade", Int64.Type}, {"tipo_vivienda", type text}, {"categoria_calidad", type text}}, "en-US")
				in
