	column 'Orden Banios' = SWITCH(TRUE(), fact_ventas[bathrooms] <= 1, 1, fact_ventas[bathrooms] <= 2, 2, fact_ventas[bathrooms] <= 3, 3, fact_ventas[bathrooms] <= 4, 4, 5)
		isHidden
		lineageTag: 3941bcc2-00aa-411f-83bf-ebc71e3889b1
		summarizeBy: none

	column 'Orden Calidad' = SWITCH(TRUE(), fact_ventas[grade] <= 6, 1, fact_ventas[grade] <= 8, 2, fact_ventas[grade] <= 10, 3, 4)
		isHidden
